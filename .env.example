# ==============================================================================
# City of Laredo Certificate Management System - Environment Template
# ==============================================================================
# Copy this file to .env before first run:
#   cp .env.example .env
#
# Values below are safe defaults/placeholders for local development.
# Replace secrets before non-local deployment.
# ==============================================================================

# -----------------------------
# Core infrastructure
# -----------------------------
POSTGRES_USER=laredo
POSTGRES_PASSWORD=laredo_dev_password
POSTGRES_DB=laredo_certificates

# -----------------------------
# mTLS (service-mesh)
# Run docker/tls/generate_certs.sh once to create all certificates.
# Set TLS_ENABLED=false to disable mTLS (plain TCP, for local debugging only).
# -----------------------------
TLS_ENABLED=true
TLS_CA_CERT=/tls/ca.crt
TLS_CLIENT_CERT=/tls/client.crt
TLS_CLIENT_KEY=/tls/client.key

# -----------------------------
# MinIO object storage
# -----------------------------
MINIO_ROOT_USER=minioadmin
# REQUIRED: set a strong password before first startup.
MINIO_ROOT_PASSWORD=
# Generate with: openssl rand -base64 32 | tr '/+' '_-' | tr -d '='
# Must be a 32-byte random value encoded as URL-safe base64 (no padding).
MINIO_ENCRYPTION_KEY=
MINIO_KMS_AUTO_ENCRYPTION=on

# -----------------------------
# App ports and auth
# -----------------------------
# REQUIRED — generate with: openssl rand -hex 32
# The application will refuse to start if this is empty or unset.
SECRET_KEY=
# Set DEBUG=true and LOG_LEVEL=DEBUG for local development only.
# Never deploy with DEBUG=true — it exposes stack traces in HTTP responses.
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------
# TLS termination (Caddy reverse proxy)
# -----------------------------
# Public hostname for HTTPS certificate and CORS origin.
# Dev: leave as localhost. Production: set to your DNS name.
PUBLIC_HOSTNAME=localhost
# Frontend URL -- used for CORS allow_origins and password reset email links.
# Must include scheme (https://) and match PUBLIC_HOSTNAME.
FRONTEND_URL=https://localhost
# Caddy port bindings (change if 443 is already in use on the host)
CADDY_HTTPS_PORT=443
# TLS mode:
#   internal (default) -> Caddy self-signs (dev/staging)
#   /path/to/cert.crt  -> static city-issued cert (set TLS_KEY too)
#   (unset both + real PUBLIC_HOSTNAME) -> ACME auto-obtains from Let's Encrypt
TLS_CERT=internal
TLS_KEY=
# MinIO console reverse proxy (Caddy routes minio.localhost here)
MINIO_BROWSER_REDIRECT_URL=https://minio.localhost

# -----------------------------
# Extraction / LLM settings
# -----------------------------
LLM_MODEL=llama3.2:3b
LLM_CONSENSUS_N=3
LLM_CONSENSUS_ENABLED=true
LLM_CONSENSUS_TEMP=0.3

# -----------------------------
# OCR
# -----------------------------
TESSERACT_LANG=eng+spa

# -----------------------------
# Outbound notification email
# -----------------------------
SMTP_HOST=greenmail
SMTP_PORT=3025
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@ci.laredo.tx.us

# -----------------------------
# IMAP email intake
# -----------------------------
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_USER=certs@ci.laredo.tx.us
IMAP_PASSWORD=any
# GreenMail dev server uses plaintext IMAP on port 3143.
# For production (port 993 with SSL), set IMAP_USE_SSL=true.
IMAP_USE_SSL=false
IMAP_INBOX_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed
ALLOWED_EMAIL_DOMAIN=ci.laredo.tx.us
EMAIL_POLL_INTERVAL_SECONDS=60

# -----------------------------
# Malware scanning
# -----------------------------
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
# SECURITY: fail-closed means attachments are quarantined if ClamAV is unreachable.
# Set to true only if you explicitly accept the risk of unscanned attachments passing through.
CLAMAV_FAIL_OPEN=false

# -----------------------------
# Optional tooling ports/credentials
# -----------------------------
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_API_PORT=8080
GREENMAIL_BIND_HOST=127.0.0.1
ROUNDCUBE_PORT=9090
ROUNDCUBE_BIND_HOST=127.0.0.1
# Roundcube city directory plugin PostgreSQL DSN. Override in production with the actual DB credentials.
# Default uses POSTGRES_PASSWORD expansion: pgsql://laredo:<password>@postgres:5432/laredo_certificates
CITY_DIRECTORY_DSN=

# -----------------------------
# SMTP TLS (outbound email)
# -----------------------------
# Controls STARTTLS for aiosmtplib. Auto-detected by port if unset.
# Set to "true" for production (port 587), "false" for GreenMail dev.
# SMTP_USE_STARTTLS=true

# -----------------------------
# Roundcube production overrides
# For dev (GreenMail), leave these unset -- defaults are safe.
# For production (M365), uncomment and set:
# -----------------------------
# ROUNDCUBE_IMAP_HOST=ssl://outlook.office365.com
# ROUNDCUBE_IMAP_PORT=993
# ROUNDCUBE_SMTP_HOST=tls://smtp.office365.com
# ROUNDCUBE_SMTP_PORT=587
# ROUNDCUBE_IMAP_VERIFY_PEER=true
# ROUNDCUBE_IMAP_VERIFY_PEER_NAME=true
# ROUNDCUBE_SMTP_VERIFY_PEER=true
# ROUNDCUBE_SMTP_VERIFY_PEER_NAME=true
# ROUNDCUBE_SMTP_AUTH_TYPE=LOGIN
# ROUNDCUBE_SMTP_USER=%u
# ROUNDCUBE_SMTP_PASS=%p

PGADMIN_EMAIL=admin@ci.laredo.tx.us
# pgAdmin grants full database access. Use a strong, unique password.
PGADMIN_PASSWORD=

# -----------------------------
# Per-service MinIO credentials (AUD-41)
# -----------------------------
# The access key is the username shown above (laredo-api, etc.)
# Generate a unique secret key (32+ random characters) for each service.
MINIO_API_SECRET_KEY=change_me_in_production
MINIO_EXTRACTION_SECRET_KEY=change_me_in_production
MINIO_EMAIL_INTAKE_SECRET_KEY=change_me_in_production

# -----------------------------
# Per-service PostgreSQL credentials (AUD-40)
# -----------------------------
# Generate unique passwords for each role — do not reuse POSTGRES_PASSWORD
EXTRACTION_WORKER_DB_PASSWORD=change_me_in_production
SCHEDULER_WORKER_DB_PASSWORD=change_me_in_production
EMAIL_INTAKE_WORKER_DB_PASSWORD=change_me_in_production
